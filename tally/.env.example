# Create a key at https://tally.so/settings/api-keys (shown only once)
TALLY_API_KEY=tly-xxxxxxxxxxxxxxxx

# Tally's public API. Only change this if Tally moves it.
TALLY_BASE_URL=https://api.tally.so

# Port the proxy + PWA are served from (n8n-mobile uses 3080)
PORT=3081

# How long the proxy reuses a Tally response, in ms. Tally allows
# 100 requests/minute, so this keeps rapid refreshes cheap.
CACHE_TTL_MS=10000
